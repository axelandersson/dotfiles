#!/usr/bin/env perl

use strict;
use warnings;
use CLI;
use CLI::Git;

my $options = CLI::options();
my $branch = shift @ARGV;

CLI::usage() if $options->{"help"};

CLI::usage("<branch>") if $options->{"help"} || !$branch;

if(my $pattern = CLI::Git::configget("cli.branchnew.forbiddennamepattern")) {
    if($branch =~ qr/$pattern/) {
        CLI::assert("Branch name \"$branch\" matches forbidden pattern \"$pattern\"");
    }
}

my $parent = CLI::Git::branch();

CLI::Git::configset("cli.branchswitch.lastbranch", $parent, $CLI::Git::CONFIGLOCAL);

CLI::run(["git", "checkout", "-b", $branch]);

# record where the branch came from, so "git dc" can diff against it later

if($parent && $parent ne "HEAD") {
    CLI::Git::configset("branch.$branch.base", $parent, $CLI::Git::CONFIGLOCAL);
}
